# Server Configuration
PORT=3000
NODE_ENV=development
BASE_URL=http://localhost:3000
JWT_SECRET=super_secret_jwt_key_here

# Binance Pay & Spot API Credentials (Get from https://merchant.binance.com)
BINANCE_PAY_API_KEY=
BINANCE_PAY_SECRET_KEY=
BINANCE_PAY_BASE_URL=https://bpay.binanceapi.com
BINANCE_SPOT_BASE_URL=https://api.binance.com

# Supabase PostgreSQL Cloud Database Configuration (Optional: provides cloud storage for all users & orders)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Webhook Callback URL
WEBHOOK_URL=http://localhost:3000/api/v1/payments/webhook

# Mock Mode (Set to true to test without live Binance keys)
MOCK_MODE=true

# System Telegram Bot Token (Optional: Get from @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=
